# Supabase 프로젝트 설정 값. Supabase 대시보드 → 프로젝트 → Settings → API 에서 복사.
# 실제 값은 .env.local 파일에 채워 넣는다 (.env.local은 .gitignore에 의해 커밋되지 않음).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 관리자 전용 기능(클럽 설정, 기사 승인/반려) 비밀번호 보호용.
# 실제 값은 여기에 절대 넣지 않는다 — 코드/깃에 비밀번호가 들어가면 안 되므로,
# Vercel 프로젝트 환경변수(Settings → Environment Variables)에 직접 등록해서 쓴다.
# 서버(Server Actions)에서만 읽는 값이라 NEXT_PUBLIC_ 접두사를 붙이지 않는다.
ADMIN_PASSWORD=

# Supabase 대시보드 → 프로젝트 → Settings → API → service_role 키.
# RLS를 완전히 우회하는 키라서 절대 브라우저에 노출되면 안 된다(NEXT_PUBLIC_ 접두사
# 금지). 비밀번호로 인증된 관리자 Server Action(클럽 설정 수정, 기사 승인/반려)에서만
# 서버 쪽 코드로 사용한다. 이 값도 Vercel 환경변수에 직접 등록할 것.
SUPABASE_SERVICE_ROLE_KEY=
